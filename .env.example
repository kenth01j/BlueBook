PORT=5000
APP_WORKERS=2
INSTANCE_ID=
NODE_ENV=development
TRUST_PROXY=loopback
MONGODB_URI=mongodb+srv://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_CLUSTER.mongodb.net/bipsu_bluebook?retryWrites=true&w=majority
MONGODB_MAX_POOL_SIZE=10
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG
